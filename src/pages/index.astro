---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import AdUnit from '../components/AdUnit.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Linear-style Glow Effect */
			.cards-grid:hover > .card::after {
				opacity: 1;
			}
			.card {
				background-color: rgba(255, 255, 255, 0.02);
				position: relative;
			}
			.card::before, .card::after {
				content: "";
				position: absolute;
				left: 0; top: 0; width: 100%; height: 100%;
				border-radius: inherit;
				transition: opacity 0.3s;
				z-index: -1;
			}
			.card::before {
				background: radial-gradient(800px circle at var(--mouse-x) var(--mouse-y), rgba(255, 255, 255, 0.06), transparent 40%);
				opacity: 0;
			}
			.card::after {
				background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(255, 255, 255, 0.4), transparent 40%);
				opacity: 0;
			}
			.card:hover::before {
				opacity: 1;
			}
			.card-content {
				background-color: #0a0a0a;
				margin: 1px;
				height: calc(100% - 2px);
				border-radius: inherit;
			}
		</style>
	</head>
	<body class="bg-black text-[#ededed] min-h-screen flex flex-col font-sans antialiased selection:bg-white selection:text-black">
		<Header />
		
		<main class="flex-grow max-w-5xl mx-auto px-6 py-24 w-full">
			<section class="mb-24 relative">
				<div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-white opacity-5 blur-[120px] rounded-full pointer-events-none"></div>
				<h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-white mb-6 leading-[1.1] max-w-4xl">
					Engineering the future of <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-200 to-gray-600">autonomous systems.</span>
				</h1>
				<p class="text-[#888] text-xl max-w-2xl leading-relaxed">
					Deep dives into algorithmic wealth, system architecture, and modern market mechanics. Built for builders.
				</p>
			</section>

			<div class="mb-16">
				<AdUnit />
			</div>

			<section>
				<div class="flex items-center justify-between mb-8 pb-4">
					<h2 class="text-xs font-semibold text-white uppercase tracking-widest">Latest Transmissions</h2>
					<a href="/money-making-blog/blog" class="text-sm text-white hover:text-[#888] transition-colors">View all ↗</a>
				</div>
				<div class="cards-grid grid grid-cols-1 md:grid-cols-2 gap-6" id="cards">
					{
						posts.map((post) => (
							<a href={`/money-making-blog/blog/${post.id}/`} class="card rounded-2xl block">
								<div class="card-content p-5 flex flex-col">
									<div class="aspect-video w-full overflow-hidden rounded-xl mb-6 bg-[#111] relative">
										{post.data.heroImage && (
											<img 
												src={post.data.heroImage} 
												alt="" 
												class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
											/>
										)}
									</div>
									<div class="flex-grow">
										<div class="text-[#888] text-xs font-mono mb-3">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h3 class="text-2xl font-bold text-white mb-3 leading-snug">{post.data.title}</h3>
										<p class="text-[#888] text-sm line-clamp-2 leading-relaxed">
											{post.data.description}
										</p>
									</div>
								</div>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			document.getElementById("cards").onmousemove = e => {
				for(const card of document.getElementsByClassName("card")) {
					const rect = card.getBoundingClientRect(),
						  x = e.clientX - rect.left,
						  y = e.clientY - rect.top;

					card.style.setProperty("--mouse-x", `${x}px`);
					card.style.setProperty("--mouse-y", `${y}px`);
				}
			}
		</script>
	</body>
</html>
