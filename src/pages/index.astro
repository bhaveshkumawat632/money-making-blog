---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import AdUnit from '../components/AdUnit.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-black text-[#ededed] min-h-screen flex flex-col font-sans antialiased">
		<Header />
		
		<main class="flex-grow max-w-5xl mx-auto px-6 py-24 w-full">
			<section class="mb-24">
				<h1 class="text-4xl md:text-6xl font-semibold tracking-tighter text-white mb-6 leading-tight max-w-3xl">
					Engineering the future of autonomous systems and passive income.
				</h1>
				<p class="text-[#888] text-lg max-w-2xl leading-relaxed">
					Deep dives into algorithmic wealth, system architecture, and modern market mechanics. Built for builders.
				</p>
			</section>

			<div class="mb-16">
				<AdUnit />
			</div>

			<section>
				<div class="flex items-center justify-between mb-8 border-b border-white/10 pb-4">
					<h2 class="text-sm font-medium text-[#888] uppercase tracking-widest">Latest Transmissions</h2>
					<a href="/money-making-blog/blog" class="text-sm text-white hover:text-[#888] transition-colors">View all →</a>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{
						posts.map((post) => (
							<a href={`/money-making-blog/blog/${post.id}/`} class="group block border border-white/5 rounded-xl bg-[#0a0a0a] hover:bg-[#111] transition-all p-4">
								<div class="aspect-video w-full overflow-hidden rounded-lg mb-4 bg-[#111]">
									{post.data.heroImage && (
										<img 
											src={post.data.heroImage} 
											alt="" 
											class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity grayscale group-hover:grayscale-0"
										/>
									)}
								</div>
								<div>
									<div class="text-[#888] text-xs font-mono mb-2">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="text-lg font-medium text-white mb-2 group-hover:text-white/90">{post.data.title}</h3>
									<p class="text-[#888] text-sm line-clamp-2 leading-relaxed">
										{post.data.description}
									</p>
								</div>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
