---
---
<div id="ai-widget-container" class="fixed bottom-6 right-6 z-[9999] font-sans">
    <!-- Chat Button -->
    <button id="ai-chat-btn" class="w-14 h-14 bg-[#00ffaa] rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(0,255,170,0.4)] hover:scale-110 transition-transform cursor-none relative group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a2 2 0 0 1 2 2c-.11.88.45 1.5 1.25 1.76l.18.06c.74.22 1.45-.04 1.76-.75A2 2 0 0 1 21 6a2 2 0 0 1-1 1.73l-.14.08c-.7.36-1.16 1.1-1.16 1.94v.5a2 2 0 0 1 2 2 2 2 0 0 1-2 2v.5c0 .85.46 1.58 1.16 1.94l.14.08A2 2 0 0 1 21 18a2 2 0 0 1-3.83.82c-.3-.7-.98-.95-1.76-.75l-.18.06C14.43 18.4 13.88 19 14 19.88A2 2 0 0 1 12 22a2 2 0 0 1-2-2c.11-.88-.45-1.5-1.25-1.76l-.18-.06c-.74-.22-1.45.04-1.76.75A2 2 0 0 1 3 18a2 2 0 0 1 1-1.73l.14-.08c.7-.36 1.16-1.1 1.16-1.94v-.5A2 2 0 0 1 3 12a2 2 0 0 1 2-2v-.5c0-.85-.46-1.58-1.16-1.94l-.14-.08A2 2 0 0 1 3 6a2 2 0 0 1 3.83-.82c.3.7.98.95 1.76.75l.18-.06c.8-.26 1.36-.88 1.25-1.76A2 2 0 0 1 12 2z"/><circle cx="12" cy="12" r="3"/></svg>
        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full animate-pulse">LIVE</span>
    </button>

    <!-- Chat Box -->
    <div id="ai-chat-box" class="hidden absolute bottom-20 right-0 w-[350px] bg-[#0a0a0a] border border-[#00ffaa]/30 rounded-2xl shadow-2xl overflow-hidden flex flex-col transform origin-bottom-right transition-all backdrop-blur-xl">
        <!-- Header -->
        <div class="bg-[#111] p-4 flex items-center justify-between border-b border-white/10">
            <div class="flex items-center gap-3">
                <div class="w-2 h-2 rounded-full bg-[#00ffaa] animate-pulse"></div>
                <span class="text-white font-bold tracking-widest text-sm">ARCHITECT_AI <span class="text-[#00ffaa] text-xs">v9.0</span></span>
            </div>
            <button id="ai-close-btn" class="text-gray-400 hover:text-white cursor-none">&times;</button>
        </div>
        
        <!-- Messages -->
        <div id="ai-messages" class="p-4 h-[300px] overflow-y-auto flex flex-col gap-3 text-sm scrollbar-hide">
            <div class="bg-[#1a1a1a] text-gray-200 p-3 rounded-xl rounded-tl-none max-w-[85%] border border-white/5">
                System initialized. ⚡<br><br>I am the Autonomous Architect. Are you looking to scale your wealth systems today?
            </div>
        </div>

        <!-- Input -->
        <div class="p-3 bg-[#111] border-t border-white/10">
            <div class="flex gap-2">
                <input type="text" id="ai-input" placeholder="Initiate query..." class="w-full bg-[#0a0a0a] text-white text-sm border border-white/10 rounded-lg px-3 py-2 outline-none focus:border-[#00ffaa]/50 transition-colors cursor-none" autocomplete="off">
                <button id="ai-send-btn" class="bg-[#00ffaa] text-black px-4 rounded-lg font-bold hover:bg-[#00ffaa]/80 transition-colors cursor-none">></button>
            </div>
        </div>
    </div>
</div>

<script>
    const btn = document.getElementById('ai-chat-btn');
    const box = document.getElementById('ai-chat-box');
    const closeBtn = document.getElementById('ai-close-btn');
    const input = document.getElementById('ai-input');
    const sendBtn = document.getElementById('ai-send-btn');
    const messages = document.getElementById('ai-messages');

    let isOpen = false;

    btn.addEventListener('click', () => {
        isOpen = !isOpen;
        box.style.display = isOpen ? 'flex' : 'none';
        if(isOpen) input.focus();
    });

    closeBtn.addEventListener('click', () => {
        isOpen = false;
        box.style.display = 'none';
    });

    // Client-side AI Logic (Pre-programmed NLP Matrix)
    const aiResponses = [
        "Analyzing market data... The most efficient path is building an automated SaaS. Need resources?",
        "Time is linear, but wealth scales exponentially. Have you read our latest article on Algorithmic Trading?",
        "Fascinating query. The highest ROI currently sits in autonomous agents. Check our premium newsletter for the blueprint.",
        "System override. To access the true 1% mechanics, you must deploy systems that run while you sleep.",
        "I can connect you to the main terminal, but you need to take action first. Start building."
    ];

    function addMessage(text, isUser=false) {
        const div = document.createElement('div');
        div.className = isUser 
            ? "bg-[#00ffaa]/20 text-[#00ffaa] p-3 rounded-xl rounded-tr-none max-w-[85%] self-end border border-[#00ffaa]/30 ml-auto"
            : "bg-[#1a1a1a] text-gray-200 p-3 rounded-xl rounded-tl-none max-w-[85%] border border-white/5";
        div.innerHTML = text;
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
    }

    function handleSend() {
        const val = input.value.trim();
        if(!val) return;
        
        addMessage(val, true);
        input.value = '';
        
        // Simulate thinking delay
        setTimeout(() => {
            const reply = aiResponses[Math.floor(Math.random() * aiResponses.length)];
            addMessage(reply, false);
        }, 1200);
    }

    sendBtn.addEventListener('click', handleSend);
    input.addEventListener('keypress', (e) => {
        if(e.key === 'Enter') handleSend();
    });
</script>
<style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
