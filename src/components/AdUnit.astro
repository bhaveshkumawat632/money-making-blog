---
export interface Props {
  adSlot?: string;
}
const { adSlot = "auto" } = Astro.props;
---
<div class="ad-container my-8 flex justify-center w-full bg-slate-100 p-4 rounded-xl border border-dashed border-slate-300 relative">
  <span class="absolute top-2 right-2 text-[10px] uppercase font-bold text-slate-400 tracking-wider">Advertisement</span>
  
  <ins class="adsbygoogle w-full"
       style="display:block; min-height: 250px;"
       data-ad-client="ca-pub-3041951952998611"
       data-ad-slot={adSlot}
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>
       (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
