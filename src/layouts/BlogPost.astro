---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AdUnit from '../components/AdUnit.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.prose {
				color: #a1a1aa;
				font-size: 1.05rem;
				line-height: 1.75;
			}
			.prose h1, .prose h2, .prose h3 {
				color: #fff;
				font-weight: 600;
				letter-spacing: -0.025em;
				margin-top: 2em;
				margin-bottom: 0.75em;
			}
			.prose p {
				margin-bottom: 1.5em;
			}
			.prose a {
				color: #fff;
				text-decoration: underline;
				text-underline-offset: 4px;
				text-decoration-color: #333;
				transition: text-decoration-color 0.2s;
			}
			.prose a:hover {
				text-decoration-color: #fff;
			}
			.prose strong {
				color: #fff;
				font-weight: 600;
			}
			.prose ul, .prose ol {
				margin-bottom: 1.5em;
				padding-left: 1.5em;
			}
			.prose li {
				margin-bottom: 0.5em;
			}
		</style>
	</head>

	<body class="bg-black text-[#ededed] min-h-screen flex flex-col antialiased font-sans">
		<Header />
		
		<main class="flex-grow w-full max-w-3xl mx-auto px-6 py-20">
			<article>
				<header class="mb-14">
					<div class="text-[#888] font-mono text-sm mb-6 flex items-center gap-2">
						<FormattedDate date={pubDate} />
						{updatedDate && <span>• Updated <FormattedDate date={updatedDate} /></span>}
					</div>
					<h1 class="text-3xl md:text-5xl font-semibold tracking-tighter text-white leading-tight mb-8">
						{title}
					</h1>
					
					{heroImage && (
						<div class="w-full aspect-[2/1] rounded-xl overflow-hidden border border-white/10 bg-[#111]">
							<img src={heroImage} alt="" class="w-full h-full object-cover grayscale opacity-90" />
						</div>
					)}
				</header>
				
				<div class="my-12">
					<AdUnit />
				</div>
				
				<div class="prose max-w-none">
					<slot />
				</div>
				
				<div class="my-16 pt-8 border-t border-white/10">
					<AdUnit />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
