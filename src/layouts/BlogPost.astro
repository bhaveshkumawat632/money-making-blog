---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AdUnit from '../components/AdUnit.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			body {
				background-color: #030712;
				color: #e5e7eb;
				font-family: 'Inter', system-ui, sans-serif;
			}
			.prose {
				color: #d1d5db;
				font-size: 1.125rem;
				line-height: 1.8;
			}
			.prose h1, .prose h2, .prose h3 {
				color: #f3f4f6;
				font-weight: 800;
				margin-top: 2.5em;
				margin-bottom: 1em;
			}
			.prose a {
				color: #38bdf8;
				text-decoration: none;
				border-bottom: 1px solid rgba(56, 189, 248, 0.3);
				transition: border-color 0.2s;
			}
			.prose a:hover {
				border-color: #38bdf8;
			}
			.prose strong {
				color: #f9fafb;
				font-weight: 700;
			}
			.hero-image {
				box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 30px rgba(56, 189, 248, 0.15);
			}
		</style>
	</head>

	<body class="antialiased min-h-screen flex flex-col">
		<Header />
		
		<main class="flex-grow w-full max-w-4xl mx-auto px-6 py-12">
			<article>
				<div class="mb-12 rounded-3xl overflow-hidden hero-image border border-gray-800">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" class="w-full h-auto object-cover" />}
				</div>
				<div class="prose max-w-none">
					<div class="text-center mb-12">
						<div class="text-teal-400 font-mono text-sm tracking-widest uppercase mb-4 font-bold flex justify-center items-center gap-2">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="text-gray-500 italic">
										(Updated on <FormattedDate date={updatedDate} />)
									</span>
								)
							}
						</div>
						<h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">{title}</h1>
						<div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-teal-400 mx-auto rounded-full mb-8"></div>
					</div>
					
					<div class="my-10">
						<AdUnit />
					</div>
					
					<div class="content-wrapper">
						<slot />
					</div>
					
					<div class="my-10">
						<AdUnit />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
