---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AdUnit from '../components/AdUnit.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.prose {
				color: #a1a1aa;
				font-size: 1.125rem;
				line-height: 1.8;
			}
			.prose h1, .prose h2, .prose h3 {
				color: #fff;
				font-weight: 700;
				letter-spacing: -0.025em;
				margin-top: 2.5em;
				margin-bottom: 1em;
			}
			.prose p {
				margin-bottom: 1.75em;
			}
			.prose a {
				color: #fff;
				text-decoration: underline;
				text-underline-offset: 4px;
				text-decoration-color: #333;
				transition: text-decoration-color 0.2s;
			}
			.prose a:hover {
				text-decoration-color: #fff;
			}
			.prose strong {
				color: #fff;
				font-weight: 600;
			}
			#progress-bar {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				background: #fff;
				width: 0%;
				z-index: 100;
				transition: width 0.1s ease-out;
			}
		</style>
	</head>

	<body class="bg-black text-[#ededed] min-h-screen flex flex-col antialiased font-sans selection:bg-white selection:text-black">
		<div id="progress-bar"></div>
		<Header />
		
		<main class="flex-grow w-full max-w-3xl mx-auto px-6 py-20 relative">
			<article>
				<header class="mb-14">
					<div class="text-[#888] font-mono text-sm mb-6 flex items-center gap-2">
						<FormattedDate date={pubDate} />
						{updatedDate && <span>• Updated <FormattedDate date={updatedDate} /></span>}
					</div>
					<h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-white leading-tight mb-8">
						{title}
					</h1>
					
					{heroImage && (
						<div class="w-full aspect-[2/1] rounded-2xl overflow-hidden bg-[#111] shadow-[0_0_50px_rgba(255,255,255,0.05)]">
							<img src={heroImage} alt="" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
						</div>
					)}
				</header>
				
				<div class="my-12">
					<AdUnit />
				</div>
				
				<div class="prose max-w-none">
					<slot />
				</div>
				
				<div class="my-16 pt-8 border-t border-white/10">
					<AdUnit />
				</div>
			</article>
		</main>
		<Footer />

		<script>
			window.addEventListener('scroll', () => {
				const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = (winScroll / height) * 100;
				document.getElementById("progress-bar").style.width = scrolled + "%";
			});
		</script>
	</body>
</html>
