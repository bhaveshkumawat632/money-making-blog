---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AdUnit from '../components/AdUnit.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.prose {
				color: #a1a1aa;
				font-size: 1.125rem;
				line-height: 1.8;
			}
			.prose h1, .prose h2, .prose h3 {
				color: #fff;
				font-weight: 700;
				letter-spacing: -0.025em;
				margin-top: 2.5em;
				margin-bottom: 1em;
			}
			.prose p { margin-bottom: 1.75em; }
			.prose a {
				color: #fff;
				text-decoration: underline;
				text-underline-offset: 4px;
				text-decoration-color: #333;
				transition: text-decoration-color 0.2s;
			}
			.prose a:hover { text-decoration-color: #fff; }
			.prose strong { color: #fff; font-weight: 600; }
			
			/* Reading Progress Bar */
			#progress-bar {
				position: fixed; top: 0; left: 0; height: 3px;
				background: linear-gradient(90deg, #38bdf8, #818cf8);
				width: 0%; z-index: 100; transition: width 0.1s ease-out;
			}

			/* Mac OS Window Style for Hero Image */
			.mac-window {
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255,255,255,0.1);
				background: #111;
				box-shadow: 0 30px 60px rgba(0,0,0,0.5);
			}
			.mac-header {
				height: 32px;
				background: #1a1a1a;
				border-bottom: 1px solid rgba(255,255,255,0.05);
				display: flex; align-items: center; padding: 0 16px; gap: 8px;
			}
			.mac-dot {
				width: 10px; height: 10px; border-radius: 50%;
			}
			.dot-red { background: #ff5f56; }
			.dot-yellow { background: #ffbd2e; }
			.dot-green { background: #27c93f; }

			/* Floating Subscribe Widget */
			.floating-widget {
				position: fixed; bottom: 30px; right: 30px;
				background: rgba(10, 10, 10, 0.8);
				backdrop-filter: blur(12px);
				border: 1px solid rgba(255,255,255,0.1);
				border-radius: 100px;
				padding: 8px 24px;
				display: flex; align-items: center; gap: 16px;
				box-shadow: 0 10px 30px rgba(0,0,0,0.5);
				z-index: 50;
				transform: translateY(100px);
				opacity: 0;
				transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.floating-widget.visible {
				transform: translateY(0);
				opacity: 1;
			}
		</style>
	</head>

	<body class="bg-black text-[#ededed] min-h-screen flex flex-col antialiased font-sans selection:bg-white selection:text-black">
		<div id="progress-bar"></div>
		<Header />
		
		<main class="flex-grow w-full max-w-3xl mx-auto px-6 py-20 relative">
			<article>
				<header class="mb-14">
					<div class="text-[#888] font-mono text-sm mb-6 flex items-center gap-2">
						<FormattedDate date={pubDate} />
						{updatedDate && <span>• Updated <FormattedDate date={updatedDate} /></span>}
					</div>
					<h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-white leading-tight mb-8">
						{title}
					</h1>
					
					{heroImage && (
						<div class="mac-window w-full aspect-[2/1] relative group">
							<div class="mac-header">
								<div class="mac-dot dot-red"></div>
								<div class="mac-dot dot-yellow"></div>
								<div class="mac-dot dot-green"></div>
							</div>
							<img src={heroImage} alt="" class="w-full h-[calc(100%-32px)] object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700" />
						</div>
					)}
				</header>
				
				<div class="my-12">
					<AdUnit />
				</div>
				
				<div class="prose max-w-none">
					<slot />
				</div>
				
				<div class="my-16 pt-8 border-t border-white/10">
					<AdUnit />
				</div>
			</article>
		</main>
		<Footer />

		<!-- Floating Subscribe Widget -->
		<div class="floating-widget" id="subscribe-widget">
			<span class="text-sm font-medium text-white">Join 15,000+ Architects</span>
			<button class="bg-white text-black px-4 py-1.5 rounded-full text-sm font-bold hover:bg-gray-200 transition-colors">
				Subscribe
			</button>
		</div>

		<script>
			// Progress Bar & Widget Reveal
			window.addEventListener('scroll', () => {
				const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = (winScroll / height) * 100;
				document.getElementById("progress-bar").style.width = scrolled + "%";

				// Reveal widget after scrolling 20%
				const widget = document.getElementById("subscribe-widget");
				if (scrolled > 20) {
					widget.classList.add("visible");
				} else {
					widget.classList.remove("visible");
				}
			});
		</script>
	</body>
</html>
